<%= link_to "一覧ページ", expenses_path%>

<% if expense.errors.any? %>
  <div style="color: red;">
    <ul>
      <% @expense.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with(model: @expense, local: true) do |form| %>
  <div>
    <%= form.label :used_on, "利用日" %>
    <%= form.date_field :used_on %>
  </div>

  <div>
    <%= form.label :merchant_name, "利用先" %>
    <%= form.text_field :merchant_name %>
  </div>

  <div>
    <%= form.label :amount, "金額" %>
    <%= form.number_field(:amount, min: 1, step: 1) %>
  </div>

  <div>
    <%= form.label :category, "カテゴリ" %>
    <%= form.text_field :category %>
  </div>

  <div>
    <%= form.label :memo, "メモ" %>
    <%= form.text_field :memo %>
  </div>

  <%= form.submit %>
<% end %>
